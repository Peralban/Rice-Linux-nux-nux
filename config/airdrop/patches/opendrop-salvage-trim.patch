                 regular = (mode & 0o170000) == 0o100000
-                out.append((name, data_off + filesize <= n, regular))
+                # HOW MANY BYTES ACTUALLY ARRIVED, not just whether the member
+                # is whole. libarchive pads a truncated member out to its
