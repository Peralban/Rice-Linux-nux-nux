diff --git a/daemon/airdrop-confirm b/daemon/airdrop-confirm
index 5a72771..c2d4e3c 100755
--- a/daemon/airdrop-confirm
+++ b/daemon/airdrop-confirm
@@ -31,18 +31,82 @@ TIMEOUT="${AIRDROP_CONFIRM_TIMEOUT:-45}"
 
 log() { printf '[airdrop-confirm] %s\n' "$*" >&2; }
 
-if ! command -v swaynag >/dev/null 2>&1; then
-  log "swaynag not found - DECLINING (cannot ask, so cannot consent)"
-  exit 1
-fi
-if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${SWAYSOCK:-}" ]; then
+if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${SWAYSOCK:-}" ] \
+   && [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
   log "no Wayland session visible - DECLINING (nobody to ask)"
   exit 1
 fi
 
-MSG="AirDrop: accept file from ${SENDER}?"
+MSG="AirDrop : accepter un fichier de ${SENDER} ?"
 [ -n "$DETAIL" ] && MSG="$MSG"$'\n'"$DETAIL"
 
+# UNE NOTIFICATION PLUTOT QU'UNE FENETRE, quand il y a vraiment quelqu'un pour
+# la recevoir. hyprland-dialog dessine une boite au milieu de l'ecran qui vole
+# le focus - pour une demande qui arrive sans prevenir, plusieurs fois de suite,
+# c'est brutal. La notification se pose la ou se posent toutes les autres, avec
+# ses deux boutons, et se repond sans quitter ce qu'on faisait.
+#
+# Le commentaire amont plus haut refusait notify-send parce qu'aucun demon de
+# notification ne tournait sur SA machine : l'appel aurait rendu 0 sans rien
+# montrer a personne, ce qui est le pire echec possible pour une demande de
+# consentement. L'objection est juste, alors on la traite plutot que de
+# l'ignorer - on demande au bus si quelqu'un sert bien org.freedesktop.
+# Notifications, et sinon on tombe sur la fenetre. Et comme -A n'ecrit sur
+# stdout que le nom de l'action choisie, seul un "accept" franc accepte :
+# expiration, fermeture, clic a cote, demon absent, tout cela refuse.
+if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
+   && command -v notify-send >/dev/null 2>&1 \
+   && command -v gdbus >/dev/null 2>&1 \
+   && [ "$(gdbus call --session --dest org.freedesktop.DBus \
+             --object-path /org/freedesktop/DBus \
+             --method org.freedesktop.DBus.NameHasOwner \
+             org.freedesktop.Notifications 2>/dev/null)" = "(true,)" ]; then
+  # -u critical : swaync garde les critiques a l'ecran jusqu'a reponse. Une
+  # demande de consentement qui s'efface toute seule au bout de 5 s serait une
+  # acceptation implicite deguisee en refus silencieux.
+  #
+  # -A implique --wait et bloque donc sans limite ; `timeout` fournit le delai.
+  ANSWER=$(timeout "$TIMEOUT" notify-send \
+      -a "AirDrop" -u critical -i "network-wireless-symbolic" \
+      -A "accept=✓ Accepter" -A "decline=✕ Refuser" \
+      "AirDrop — ${SENDER}" "${DETAIL:-Fichier entrant}" 2>/dev/null)
+  rc=$?
+  case "$ANSWER" in
+    accept)  log "accepted by user"; exit 0 ;;
+    decline) log "declined by user"; exit 1 ;;
+    *)
+      if [ "$rc" -eq 124 ]; then log "no answer within ${TIMEOUT}s - declining"
+      else log "notification gave no usable answer (rc=$rc) - declining"; fi
+      exit 1 ;;
+  esac
+fi
+
+# Hyprland plutot que Sway. hyprland-dialog joue exactement le role que
+# swaynag joue sur sway - il dessine sa propre surface et bloque jusqu'a la
+# reponse - mais il ECRIT LE BOUTON CHOISI SUR STDOUT, ce qui supprime d'un
+# coup toute la mecanique de fichiers-marqueurs plus bas, et avec elle la
+# course de 2 ms qu'elle existait pour rattraper. `timeout` fournit le delai
+# que l'outil n'a pas, et tout ce qui n'est pas un "Accepter" franc refuse.
+if command -v hyprland-dialog >/dev/null 2>&1; then
+  ANSWER=$(timeout "$TIMEOUT" hyprland-dialog \
+      --title "AirDrop" --apptitle "AirDrop" \
+      --text "$MSG" --buttons "Accepter;Refuser" 2>/dev/null)
+  rc=$?
+  case "$ANSWER" in
+    Accepter) log "accepted by user"; exit 0 ;;
+    Refuser)  log "declined by user"; exit 1 ;;
+    *)
+      if [ "$rc" -eq 124 ]; then log "no answer within ${TIMEOUT}s - declining"
+      else log "no usable answer from hyprland-dialog (rc=$rc) - declining"; fi
+      exit 1 ;;
+  esac
+fi
+
+if ! command -v swaynag >/dev/null 2>&1; then
+  log "neither hyprland-dialog nor swaynag found - DECLINING (cannot ask, so cannot consent)"
+  exit 1
+fi
+
 # swaynag has no built-in timeout and no exit code that distinguishes the
 # buttons, so both are built here: a marker file per button, and a poll that
 # gives up after TIMEOUT. Leaving an unanswered prompt on screen forever would
diff --git a/daemon/airdrop-helper b/daemon/airdrop-helper
index 67b65fd..7eb9216 100755
--- a/daemon/airdrop-helper
+++ b/daemon/airdrop-helper
@@ -19,12 +19,11 @@
 # /etc/sudoers.d/zzz-swaylock-fp-restart entry.
 set -u
 
-PHY="${PHY:-phy0}"
+PHY="${PHY:-}"
 IFACE="${IFACE:-}"
 MON=mon0
 MONA=mon1
 GO=go0
-MT76=/sys/kernel/debug/ieee80211/$PHY/mt76
 GO_HOSTAPD=/usr/local/bin/airdrop-go-hostapd
 GO_CONF=/run/airdrop-go-hostapd.conf
 GO_LOG=/run/airdrop-go-hostapd.log
@@ -56,6 +55,17 @@ if [ -z "$IFACE" ]; then
   done
 fi
 
+# Le phy qui porte cette interface. Le defaut code en dur etait phy0, ce qui
+# casse des que le driver a ete recharge (la carte revient en phy1) ou sur une
+# machine multi-radio : `iw phy phy0 interface add` sort alors en ENOENT, que
+# le demon rapporte comme "no privilege or go0 setup failed". airdrop.sh le
+# derive deja de l'interface ; on fait pareil ici.
+if [ -z "$PHY" ] && [ -n "$IFACE" ]; then
+  PHY=$(basename "$(readlink -f "/sys/class/net/$IFACE/phy80211")" 2>/dev/null)
+fi
+PHY="${PHY:-phy0}"
+MT76=/sys/kernel/debug/ieee80211/$PHY/mt76
+
 usage() {
   cat >&2 <<'EOF'
 usage: airdrop-helper <verb> [chan]
@@ -180,7 +190,7 @@ case "${1:-}" in
 interface=$GO
 driver=nl80211
 ssid=airdrop-relay-$$
-country_code=${REG:-NZ}
+country_code=${REG:-FR}
 ieee80211d=1
 hw_mode=$hw
 channel=$chan
@@ -326,7 +336,26 @@ EOF
     # while OWL logged ten switches to 149 and ten back. So we advertise exactly
     # the peer's slots that sit on our channel and leave the rest empty: true,
     # and structurally like a real sequence.
-    strategy="${AIRDROP_OWL_STRATEGY:-intersect}"
+    # Passe a `widen`. `intersect` n'avance QUE des creneaux du pair qui
+    # tombent sur notre canal : quand le telephone reduit brievement sa
+    # fenetre, on recopie la reduction, ce qui le pousse a reduire encore -
+    # l'effondrement 15/16 -> 5/16 -> 2/16 en plein transfert, et la queue
+    # perdue. `widen` garde la sequence du pair et REMPLIT ses creneaux
+    # vides, ce qui casse la boucle par construction, et iOS 26 l'accepte
+    # (§26 ; c'est `pin`, qui remplit les 16, qui est rejete).
+    # La strategie peut aussi venir d'un fichier du home de l'appelant.
+    # `airdropd` invoque ce helper via `sudo -n` SANS -E, donc une variable
+    # d'environnement ne traverse jamais : c'est la seule facon de la changer
+    # sans reinstaller le binaire root a chaque essai. La valeur est validee
+    # contre la liste blanche ci-dessous avant tout usage, donc un fichier
+    # inscriptible par l'utilisateur ne peut que choisir parmi des noms deja
+    # autorises - il ne peut rien injecter.
+    strategy="${AIRDROP_OWL_STRATEGY:-}"
+    if [ -z "$strategy" ] && [ -n "${SUDO_USER:-}" ]; then
+      _sf=$(getent passwd "$SUDO_USER" | cut -d: -f6)/.config/airdrop/strategy
+      [ -r "$_sf" ] && strategy=$(head -c 16 "$_sf" | tr -dc 'a-z')
+    fi
+    strategy="${strategy:-widen}"
     case "$strategy" in
       pin|verbatim|fixed|intersect|widen|rotate) ;;
       *) echo "airdrop-helper: bad strategy $strategy" >&2; exit 1 ;;
@@ -334,7 +363,19 @@ EOF
 
     pkill -x airdrop-owl 2>/dev/null
     # stdbuf -oL so the log is readable live rather than in 4 KiB bursts.
-    setsid stdbuf -oL "$OWL_BIN" -i "$vif" -c "$chan" -N -S "$strategy" -vv \
+    # Largeur de `widen`. Le defaut d'owl est 4, et le pair n'ayant que 4
+    # creneaux actifs cela plafonne l'overlap a 8/16 - mesure exactement ca.
+    # Chaque creneau en plus est une fenetre de plus pour que la QUEUE du
+    # transfert passe, ce qui est precisement ce qui manque. On ne monte pas
+    # a 16 : remplir tous les creneaux revient a `pin`, mesure comme REJETE
+    # par iOS (§25). 8 donne 12/16 en laissant des trous.
+    widen="${AIRDROP_OWL_WIDEN:-8}"
+    case "$widen" in ''|*[!0-9]*) widen=8 ;; esac
+    [ "$widen" -gt 14 ] && widen=14
+    owlopts=""
+    [ "$strategy" = widen ] && owlopts="-W $widen"
+
+    setsid stdbuf -oL "$OWL_BIN" -i "$vif" -c "$chan" -N -S "$strategy" $owlopts -vv \
       >> /run/airdrop-owl.log 2>&1 &
     for _ in $(seq 60); do
       ip link show awdl0 >/dev/null 2>&1 && break
