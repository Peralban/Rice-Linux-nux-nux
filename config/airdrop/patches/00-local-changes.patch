diff --git a/daemon/airdropd b/daemon/airdropd
index 12aa1ac..c76ad29 100755
--- a/daemon/airdropd
+++ b/daemon/airdropd
@@ -908,9 +908,28 @@ serve_forever() {
           break
         fi
 
-        if ! ip link show awdl0 >/dev/null 2>&1 || ! pgrep -x airdrop-owl >/dev/null; then
-          set_state error "stack died (awdl0 or owl gone) - toggle off and on"
-          log "HEALTH: awdl0 or owl vanished while armed"
+        # THE INTERFACES, not only the processes. A living process proves
+        # nothing here: owl keeps running on a monitor vif deleted from under
+        # it without a word, and awdl0 survives as a shell with no radio
+        # behind it. Seen three times in one night, and every time the bar
+        # read `armed` while nothing could leave the antenna.
+        missing=""
+        # DUALCHAN is "0" when off, which is not empty: ${DUALCHAN:+go0}
+        # would demand go0 in single-channel mode, where it never exists.
+        _need_go=""
+        [ "$DUALCHAN" = 1 ] && _need_go=go0
+        for _vif in awdl0 "${ackvif:-mon0}" $_need_go; do
+          [ -n "$_vif" ] || continue
+          ip link show "$_vif" >/dev/null 2>&1 || missing="$missing $_vif"
+        done
+        if [ -n "$missing" ] || ! pgrep -x airdrop-owl >/dev/null; then
+          if [ -n "$missing" ]; then
+            set_state error "radio gone (missing:$missing) - toggle off and on"
+            log "HEALTH: interface(s) vanished while armed:$missing"
+          else
+            set_state error "stack died (owl gone) - toggle off and on"
+            log "HEALTH: owl vanished while armed"
+          fi
           break
         fi
         # Re-announcing lives INSIDE opendrop now (patches/opendrop-mdns-
