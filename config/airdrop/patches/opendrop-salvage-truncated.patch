+        def odc_members(cpio):
+            """(nom, donnees_completes) pour chaque membre d'un cpio ODC.
+
+            En-tete ODC : 76 octets ASCII a champs fixes, puis le nom
+            (namesize, NUL compris), puis les donnees (filesize), tout en
+            octal. On marche la structure a la main parce que libarchive
+            COMPLETE A ZERO un membre tronque jusqu'a sa taille annoncee :
+            mesure, un JPEG rendu a la bonne taille se terminait par 949 265
+            octets nuls et aucun marqueur de fin. Comparer les tailles ne
+            detecte donc rien du tout - seul le fait que les octets soient
+            reellement presents dans l'archive fait foi.
+            """
+            out, off, n = [], 0, len(cpio)
+            while off + 76 <= n:
+                if cpio[off:off + 6] != b"070707":
                     break
-                raw.write(buf)
+                try:
+                    namesize = int(cpio[off + 59:off + 65], 8)
+                    filesize = int(cpio[off + 65:off + 76], 8)
+                except ValueError:
+                    break
+                name_off = off + 76
+                name = cpio[name_off:name_off + namesize].split(b"\0")[0]
+                name = name.decode("utf-8", "replace")
+                data_off = name_off + namesize
+                if name == "TRAILER!!!":
+                    break
+                out.append((name, data_off + filesize <= n))
+                off = data_off + filesize
+            return out
+
+        def verify_extracted(cpio_bytes):
+            """Separe ce qui est arrive entier de ce qui ne l'est pas.
+
+            Les incomplets sont suffixes .partial : livrer en silence une
+            photo a moitie vide qui s'ouvre quand meme serait pire qu'un
+            echec franc.
+            """
+            good, bad = [], []
+            for name, complete in odc_members(cpio_bytes):
+                base = os.path.basename(name)
+                if not base or base == "." or base.startswith("._"):
+                    continue
+                path = os.path.join(os.getcwd(), name)
+                if not os.path.exists(path):
+                    continue
+                if complete:
+                    good.append(base)
+                else:
+                    bad.append(base)
+                    try:
+                        os.replace(path, path + ".partial")
+                    except OSError:
+                        pass
+            return good, bad
 
