/* My Mostly Used waybar config incase you wonder :) */
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 1,
"height": 0,
"fixed-center": true,
"ipc": true,
"margin-top": 1,
"margin-left": 0,
"margin-right": 0,

"modules-left": [
	"idle_inhibitor",
	"custom/separator#blank",
	"clock",
        "custom/separator#blank",	
	// Native modules rather than the tray applets' icons: these are Nerd Font
	// glyphs, so they take the bar's colour and follow the wallpaper. The
	// applet icons came from the icon theme and never did.
	"network",
	"bluetooth",
        "custom/separator#blank",	
	"tray",
        "custom/separator#blank",	
        "hyprland/workspaces#alpha",
	],

// Centre laissé libre : HyprNotch s'y pose en surface layer-shell.
"modules-center": [
	],

"modules-right": [
        //"mpris",
        //"custom/separator#dot-line",
        "custom/docker",
	"custom/separator#blank",
        "group/notify",	
	"group/brightness",
	"custom/separator#blank",
	"battery",
	"custom/separator#blank",  
	"group/audio",
	"custom/separator#blank",
	"custom/power",
	],
}

