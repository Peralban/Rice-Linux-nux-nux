# zathura colours
# Generated with Matugen
#
# zathura draws none of this through GTK CSS: every colour below is one of its
# own settings, so the gtk-4.0 palette it inherits as a GTK4 client never
# reaches the document view, the statusbar or the completion list.
#
# Included from zathurarc, which is where the non-colour settings live.

set default-bg                  "{{colors.surface_dim.default.hex}}"
set default-fg                  "{{colors.on_surface.default.hex}}"

set statusbar-bg                "{{colors.surface_container_low.default.hex}}"
set statusbar-fg                "{{colors.on_surface.default.hex}}"

set inputbar-bg                 "{{colors.surface_container.default.hex}}"
set inputbar-fg                 "{{colors.on_surface.default.hex}}"

set completion-bg               "{{colors.surface_container.default.hex}}"
set completion-fg               "{{colors.on_surface.default.hex}}"
set completion-group-bg         "{{colors.surface_container_high.default.hex}}"
set completion-group-fg         "{{colors.on_surface_variant.default.hex}}"
set completion-highlight-bg     "{{colors.primary.default.hex}}"
set completion-highlight-fg     "{{colors.on_primary.default.hex}}"

set index-bg                    "{{colors.surface.default.hex}}"
set index-fg                    "{{colors.on_surface.default.hex}}"
set index-active-bg             "{{colors.primary.default.hex}}"
set index-active-fg             "{{colors.on_primary.default.hex}}"

set notification-bg             "{{colors.surface_container.default.hex}}"
set notification-fg             "{{colors.on_surface.default.hex}}"
set notification-error-bg       "{{colors.error_container.default.hex}}"
set notification-error-fg       "{{colors.on_error_container.default.hex}}"
set notification-warning-bg     "{{colors.tertiary_container.default.hex}}"
set notification-warning-fg     "{{colors.on_tertiary_container.default.hex}}"

# Search hits sit on top of the text, so they have to be translucent. matugen
# only emits rgba() at full opacity, but GdkRGBA reads 8-digit hex, which lets
# the alpha be written here: 0x59 is about 35%, 0x8c about 55%.
set highlight-color             "#{{colors.primary.default.hex_stripped}}59"
set highlight-active-color      "#{{colors.tertiary.default.hex_stripped}}8c"

set render-loading-bg           "{{colors.surface_dim.default.hex}}"
set render-loading-fg           "{{colors.on_surface_variant.default.hex}}"

set scrollbar-bg                "{{colors.surface_container.default.hex}}"
set scrollbar-fg                "{{colors.outline.default.hex}}"

set signature-success-color     "{{colors.primary.default.hex}}"
set signature-warning-color     "{{colors.tertiary.default.hex}}"
set signature-error-color       "{{colors.error.default.hex}}"

# Only used once recolor is on, which Ctrl+R toggles. Kept in the palette so
# the toggle lands on the rice rather than on zathura's stock black on white.
set recolor-lightcolor          "{{colors.surface.default.hex}}"
set recolor-darkcolor           "{{colors.on_surface.default.hex}}"
